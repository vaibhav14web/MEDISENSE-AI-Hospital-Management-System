# AI-HMS Production Environment Configuration Template
PROJECT_NAME=AI-HMS
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production

# Security & Authentication (Generate secure 64-character secret in production)
SECRET_KEY=generate_a_random_secure_hex_key_using_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_hms
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password@127.0.0.1:5432/ai_hms

# High-Concurrency Database Connection Pooling
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# CORS Whitelist (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]

# ML Risk Categorization Sensitivity (Calibrated around ~23.3% pre-AI baseline)
ML_NO_SHOW_HIGH_THRESHOLD=0.245
ML_NO_SHOW_MEDIUM_THRESHOLD=0.220

# Frontend Client Environment Variables
VITE_API_BASE_URL=
VITE_ENABLE_PRESET_LOGINS=false
VITE_AUTO_LOGIN=false

